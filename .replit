run = "bash scripts/replit_start.sh"
entrypoint = "scripts/replit_start.sh"
modules = ["postgresql-16", "python-base-3.13", "nodejs-24"]

[nix]
channel = "stable-24_05"

[env]
PYTHONUNBUFFERED = "1"
# The engine and frontend run in the same Repl; the frontend proxies its
# browser-side Admin calls to this same-machine engine (see
# web/next.config.ts) -- only port 3000 needs to be publicly exposed.
API_BASE_URL = "http://localhost:8000"

[deployment]
run = ["bash", "scripts/replit_start.sh"]
build = ["bash", "-c", "cd /home/runner/workspace/web && pnpm install --frozen-lockfile && pnpm run build"]
deploymentTarget = "vm"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit_start.sh"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 80
