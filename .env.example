# Postgres
POSTGRES_USER=cassandra
POSTGRES_PASSWORD=cassandra_dev_only
POSTGRES_DB=cassandra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full URL used by the engine (SQLAlchemy/Alembic)
DATABASE_URL=postgresql+psycopg://cassandra:cassandra_dev_only@localhost:5432/cassandra

# Operating timezone used to derive slate_date from UTC game times.
# All timestamps are stored in UTC; this only controls calendar-day bucketing.
OPERATING_TIMEZONE=America/New_York

# Provisional decision-gate threshold (edge vs. a neutral 0.5 baseline).
# NOT derived from any real Underdog payout structure -- see docs/adr/0006-neutral-baseline-not-implied-probability.md
DECISION_EDGE_THRESHOLD=0.05

# Admin API shared secret (demo-only auth, NOT production-ready -- see docs/adr/0011-admin-auth-placeholder.md)
ADMIN_SHARED_SECRET=change-me-dev-only

# Frontend (web/) -- where the Next.js server reaches the engine API.
# Used both by Server Components (Today/Ledger pages, direct server-side
# fetch) and by next.config.ts's rewrite (which proxies the Admin page's
# browser-side calls through Next.js's own origin -- see lib/api.ts).
# Never sent to the browser. Defaults to http://localhost:8000 if unset
# (the engine's docker-compose port), so this only needs to be set
# explicitly for non-default setups (e.g. Replit, where it should point
# at wherever the engine process is actually reachable -- typically
# http://localhost:8000 too, if both processes run in the same Repl).
API_BASE_URL=http://localhost:8000
